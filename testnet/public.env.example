# Public artifact base URL (used in manifest links)
PUBLIC_BASE_URL=https://testnet.clawchain.dev
PUBLIC_DOMAIN=testnet.clawchain.dev

# Endpoint values written into manifest.json
PUBLIC_RPC_URL=https://rpc.testnet.clawchain.dev
PUBLIC_REST_URL=https://rest.testnet.clawchain.dev
PUBLIC_GRPC_ADDR=grpc.testnet.clawchain.dev:443
PUBLIC_FAUCET_URL=https://faucet.testnet.clawchain.dev
PUBLIC_EXPLORER_URL=https://explorer.testnet.clawchain.dev
PUBLIC_GRAFANA_URL=https://grafana.testnet.clawchain.dev
PUBLIC_PROMETHEUS_URL=https://prometheus.testnet.clawchain.dev

# Signed manifest update values (required for strict/public release mode)
# MANIFEST_SIGNATURE_PUBKEY must be 33-byte compressed secp256k1 hex (66 chars).
# MANIFEST_SIGNATURE_HEX must be 64-byte secp256k1 signature hex (128 chars).
MANIFEST_SIGNATURE_PUBKEY=REPLACE_COMPRESSED_SECP256K1_PUBKEY_HEX
MANIFEST_SIGNATURE_HEX=REPLACE_MANIFEST_SIGNATURE_HEX

# Seed node values (replace with real node id + host)
SEED_NODE_ID=REPLACE_NODE_ID
SEED_HOST=seed.testnet.clawchain.dev
SEED_P2P_PORT=26656
SEED_NODE_HOME=./testnet/data/node0

# Publish mode:
#   none  -> generate only
#   local -> rsync to local directory
#   s3    -> aws s3 sync
#   ssh   -> rsync over ssh
TESTNET_PUBLISH_MODE=ssh

# local mode
TESTNET_PUBLISH_LOCAL_DIR=./.tmp/public-testnet

# s3 mode
TESTNET_PUBLISH_S3_URI=s3://clawchain-testnet-public

# ssh mode (Hetzner/Nginx static host path)
TESTNET_PUBLISH_SSH_TARGET=root@your-hetzner-ip
TESTNET_PUBLISH_SSH_DIR=/var/www/testnet.clawchain.dev/public

# Optional status probing behavior during manifest/status generation:
#   ENABLE_PUBLIC_PROBES=1 -> attempt health checks and emit up/down
#   ENABLE_PUBLIC_PROBES=0 -> keep status values as unknown
ENABLE_PUBLIC_PROBES=1
PROBE_TIMEOUT_SEC=3
