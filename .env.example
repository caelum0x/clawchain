# ClawChain Docker Compose Environment Variables
# Copy to .env and fill in actual values

# Faucet key mnemonic. REQUIRED — generate a fresh 24-word BIP39 mnemonic and
# keep it in your local .env (gitignored) or a secret manager. NEVER commit a
# real mnemonic. For local/testnet use `clawchaind keys mnemonic` to generate one.
FAUCET_MNEMONIC=

# Oracle Price Feeder (needed for oracle vote submission)
PRICE_FEEDER_PASS=

# GPU Inference Sidecar (optional, needed for GPU compute features)
PROVIDER_ADDRESS=claw1r5v5srda7xfth3hn2s26txvrcrntldju3ufu0h
PROVIDER_KEY_HEX=
