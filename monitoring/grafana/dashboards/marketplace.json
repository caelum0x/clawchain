  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Skill Marketplace",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Total skills listed on the marketplace",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Skills Listed",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_marketplace_skills_listed",
          "legendFormat": "Skills",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Total skill purchases",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Total Purchases",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_skill_purchases_total",
          "legendFormat": "Purchases",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Active GPU compute resources",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "GPU Resources",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_gpu_resources_active",
          "legendFormat": "GPUs",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Active compute leases",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Active Leases",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_compute_leases_active",
          "legendFormat": "Leases",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Skill Economy",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Skill purchases over time",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Purchases",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Skill Purchases Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(clawchain_skill_purchases_total[1h])",
          "legendFormat": "Purchases (1h)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Revenue by skill category",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "CLAW",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Revenue by Skill",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(clawchain_marketplace_revenue_total[1h])",
          "legendFormat": "{{skill_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "GPU Compute",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Average GPU utilization across providers",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 20,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "GPU Utilization Average",
      "type": "gauge",
      "targets": [
        {
          "expr": "avg(clawchain_gpu_utilization_percent)",
          "legendFormat": "Avg GPU %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Inference and compute job throughput",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Jobs/s",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 15 },
      "id": 21,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Inference Job Throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(clawchain_compute_jobs_total[5m])",
          "legendFormat": "Jobs/s",
          "refId": "A"
        },
        {
          "expr": "rate(clawchain_compute_jobs_failed_total[5m])",
          "legendFormat": "Failed/s",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Model Registry",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Registered models on the chain",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 24 },
      "id": 30,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Registered Models",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_model_registry_count",
          "legendFormat": "Models",
          "refId": "A"
        }
      ]
