    {
      "datasource": "Prometheus",
      "description": "Model access count over time",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Accesses",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 24 },
      "id": 31,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Model Access Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(clawchain_model_accesses_total[1h])",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    }
