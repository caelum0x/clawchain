{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "ClawChain Agent Economy - Agent activity, tasks, rewards, and negotiations",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Agent Overview",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Number of currently active agents",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 5 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Active Agents",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_agent_active_count",
          "legendFormat": "Active",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Total registered agents",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Total Registrations",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_agent_registrations_total",
          "legendFormat": "Registrations",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Pending tasks awaiting agent execution",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Pending Tasks",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_tasks_pending",
          "legendFormat": "Pending",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Total CLAW rewards distributed to agents",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "orange", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Total Rewards Distributed",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_rewards_distributed_total",
          "legendFormat": "CLAW",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Agent Activity",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Agent registrations over time",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Registrations",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Agent Registrations Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(clawchain_agent_registrations_total[1h])",
          "legendFormat": "New Registrations (1h)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Agent heartbeat frequency",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Heartbeats/s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Heartbeat Frequency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(clawchain_agent_heartbeats_total[5m])",
          "legendFormat": "Heartbeats/s",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Task Economy",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Tasks created vs completed over time",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Tasks",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 20,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Tasks Created vs Completed",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(clawchain_tasks_created_total[5m])",
          "legendFormat": "Created/s",
          "refId": "A"
        },
        {
          "expr": "rate(clawchain_tasks_completed_total[5m])",
          "legendFormat": "Completed/s",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Task completion rate as a percentage",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 15 },
      "id": 21,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Task Completion Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "(rate(clawchain_tasks_completed_total[1h]) / rate(clawchain_tasks_created_total[1h])) * 100",
          "legendFormat": "Completion %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Negotiation volume between agents",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Negotiations",
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 15 },
      "id": 22,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Negotiation Volume",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(clawchain_negotiations_total[1h])",
          "legendFormat": "Negotiations (1h)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Rewards",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Reward distribution rate per block",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "CLAW",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 30,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Reward Distribution Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(clawchain_rewards_distributed_total[5m])",
          "legendFormat": "Rewards/s",
          "refId": "A"
        },
        {
          "expr": "rate(clawchain_reward_distribution_errors_total[5m])",
          "legendFormat": "Distribution Errors/s",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Top agents by cumulative rewards",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 31,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Value" }]
      },
      "title": "Top Agents by Rewards",
      "type": "table",
      "targets": [
        {
          "expr": "topk(10, clawchain_agent_rewards_cumulative)",
          "legendFormat": "{{agent_address}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "renameByName": {
              "agent_address": "Agent",
              "Value": "Rewards (uclaw)"
            }
          }
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["clawchain", "agent", "economy"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ClawChain - Agent Economy",
  "uid": "clawchain-agent-economy",
  "version": 1
}
