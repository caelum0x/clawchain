{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "ClawChain Privacy Pool - Shield/unshield volume, Merkle tree, nullifiers",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Privacy Pool Status",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Current size of the Merkle commitment tree",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Merkle Tree Size",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_privacy_commitment_count",
          "legendFormat": "Commitments",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Total spent nullifiers (preventing double-spend)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Nullifier Count",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_privacy_nullifier_count",
          "legendFormat": "Nullifiers",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Total value held in the privacy pool",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Privacy Pool Balance",
      "type": "stat",
      "targets": [
        {
          "expr": "clawchain_privacy_pool_balance",
          "legendFormat": "Balance (uclaw)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "ZK proof verification failures",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Proof Failures (1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(clawchain_privacy_proof_failures_total[1h])",
          "legendFormat": "Failures",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Shield / Unshield Volume",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Shield and unshield transaction volume over time",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Transactions",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Shield / Unshield Volume",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(clawchain_privacy_shields_total[5m])",
          "legendFormat": "Shields/s",
          "refId": "A"
        },
        {
          "expr": "rate(clawchain_privacy_unshields_total[5m])",
          "legendFormat": "Unshields/s",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Private transfer transaction count over time",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Transfers",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Private Transfers",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(clawchain_privacy_private_transfers_total[5m])",
          "legendFormat": "Private Transfers/s",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Merkle Tree Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Commitment count growth over time",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Commitments",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 20,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Commitment Count Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "clawchain_privacy_commitment_count",
          "legendFormat": "Total Commitments",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "description": "Merkle root transitions and integrity checks",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Events",
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 21,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Merkle Root Updates & Nullifier Duplicates",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(clawchain_privacy_merkle_root_updates_total[1h])",
          "legendFormat": "Root Updates (1h)",
          "refId": "A"
        },
        {
          "expr": "increase(clawchain_privacy_nullifier_duplicates_total[1h])",
          "legendFormat": "Nullifier Duplicates (1h)",
          "refId": "B"
        },
        {
          "expr": "increase(clawchain_privacy_merkle_root_mismatches_total[1h])",
          "legendFormat": "Root Mismatches (1h)",
          "refId": "C"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["clawchain", "privacy", "zk", "merkle"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
