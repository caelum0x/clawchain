      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 41 },
      "id": 41,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Agent Registrations Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(clawchain_agent_registrations_total[1h])",
