    function test_claimCredit_refundMode_succeeds() public {
        // Set up actors.
        address alice = address(0xa11ce);
        address bob = address(0xb0b);

        // Give the game proxy 1 extra ether, unregistered.
        vm.deal(address(gameProxy), 1 ether);

