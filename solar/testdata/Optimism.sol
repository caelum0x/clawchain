        bytes32 pausedSlot = bytes32(uint256(keccak256("superchainConfig.paused")) - 1);
        assertEq(vm.load(address(superchainConfig), pausedSlot), bytes32(0));
    }

    /// @notice Tests that `upgrade` reverts when called a second time.
