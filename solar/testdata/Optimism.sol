            }
        }
    }

    /// @dev Sets up the L1 contracts.
    function L1() public {
        console2.log("Setup: creating L1 deployments");
        // Set the deterministic deployer in state to ensure that it is there
        vm.etch(
            0x4e59b44847b379578588920cA78FbF26c0B4956C,
