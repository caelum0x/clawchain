[Unit]
Description=ClawChain Validator Node
Documentation=https://github.com/clawchain/clawchain
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clawchain
Group=clawchain
ExecStart=/usr/local/bin/clawchaind start --home /var/lib/clawchain/.clawchain
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawchaind

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clawchain

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096
MemoryMax=8G
CPUQuota=400%

# Environment
Environment="HOME=/var/lib/clawchain"

[Install]
WantedBy=multi-user.target
